---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IntroHeader from "../../components/IntroHeader.astro";
import { pageMeta } from "../../data/pages";
import {
    collectTagCounts,
    getAllPosts,
    postUrl,
    sortPostsDesc,
    type PostEntry,
} from "../../lib/posts";
import {
    ARCHIVE_TAG_CLOUD,
    tagBadgeColors,
    tagBadgeStyleAttr,
} from "../../lib/tag-cloud";

const allPosts = await getAllPosts();
const ordered = sortPostsDesc(allPosts);
const meta = pageMeta.archive;

// Tag list: unique tags with counts (order: by count desc then name, matching featured style)
const tags = [...collectTagCounts(allPosts).entries()].sort(
    (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
const postTotal = allPosts.length;
// Weight color only on count badges (角标); label text stays neutral gray.
const badgeColors = tagBadgeColors(
    tags.map(([, size]) => size),
    ARCHIVE_TAG_CLOUD
);

/** Canonical tag key for data-* attributes (raw UTF-8). URL query still uses encodeURIComponent. */
function tagKey(tag: string) {
    return tag.trim();
}

// Group by calendar year of publishedDate
type YearGroup = { year: string; posts: PostEntry[] };
const groups: YearGroup[] = [];
for (const post of ordered) {
    const year = post.data.publishedDate.slice(0, 4);
    const last = groups[groups.length - 1];
    if (!last || last.year !== year) {
        groups.push({ year, posts: [post] });
    } else {
        last.posts.push(post);
    }
}
---

<BaseLayout
    title={meta.title}
    description={meta.description}
    headerImg={meta.headerImg}
    pageUrl={meta.path}
>
    <IntroHeader
        type="page"
        title={meta.title}
        description={meta.description}
        headerImg={meta.headerImg}
        short={true}
    />

    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
                <div id="tag_cloud" class="tags tags-sup js-tags">
                    <button type="button" class="tag-button--all" data-encode="">
                        Show All
                        <sup>{postTotal}</sup>
                    </button>
                    {
                        tags.map(([tag, size], index) => {
                            const sortKey = String(postTotal - size).padStart(4, "0").slice(-4);
                            return (
                                <button
                                    type="button"
                                    data-sort={sortKey}
                                    data-encode={tagKey(tag)}
                                    class="tag-button"
                                    title={tag}
                                    rel={String(size)}
                                    style={tagBadgeStyleAttr(badgeColors[index])}
                                >
                                    {tag}
                                    <sup>{size}</sup>
                                </button>
                            );
                        })
                    }
                </div>

                <div class="mini-post-list js-result d-none">
                    {
                        groups.map((group) => (
                            <section class="archive-year-group">
                                <div class="listing-seperator archive-year-header">
                                    <span class="tag-text">{group.year}</span>
                                    <span class="archive-year-count">{group.posts.length}</span>
                                </div>
                                {group.posts.map((post) => {
                                    // Comma-separated raw tags; must match ?tag= after URLSearchParams decode.
                                    const rawTags = (post.data.tags ?? [])
                                        .map(t => tagKey(t))
                                        .filter(Boolean);
                                    const tagEnc = rawTags.join(",");
                                    const url = postUrl(post);
                                    const monthDay = post.data.publishedDate.slice(5).replace("-", ".");
                                    return (
                                        <div class="archive-item item" data-tags={tagEnc}>
                                            <a href={url} class="archive-item-link">
                                                <time class="archive-date" datetime={post.data.publishedDate}>
                                                    {monthDay}
                                                </time>
                                                <span class="archive-main">
                                                    {post.data.titleHtml ? (
                                                        <span class="archive-title" set:html={post.data.titleHtml} />
                                                    ) : (
                                                        <span class="archive-title">{post.data.title}</span>
                                                    )}
                                                    {post.data.subtitle ? (
                                                        <span class="archive-subtitle">{post.data.subtitle}</span>
                                                    ) : null}
                                                </span>
                                                {rawTags.length > 0 && (
                                                    <span class="archive-item-tags hidden-xs">
                                                        {rawTags.slice(0, 2).map(t => (
                                                            <span class="archive-item-tag">{t}</span>
                                                        ))}
                                                    </span>
                                                )}
                                            </a>
                                        </div>
                                    );
                                })}
                            </section>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
