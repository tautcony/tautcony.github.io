---
import BaseLayout from "./BaseLayout.astro";
import IntroHeader from "../components/IntroHeader.astro";
import PostContainer from "../components/PostContainer.astro";
import Sidebar from "../components/Sidebar.astro";
import Katex from "../components/Katex.astro";
import type { MarkdownHeading } from "astro";
import type { PostEntry } from "../lib/posts";
import {
    collectTagCounts,
    getPrevNext,
    postUrl,
} from "../lib/posts";
import { site } from "../data/site";

interface Props {
    post: PostEntry;
    allPosts: PostEntry[];
    /** From `render(post).headings` — SSG side catalog when `catalog: true`. */
    headings?: MarkdownHeading[];
    /** WIP under `content/drafts` — banner + noindex; not in listings. */
    draft?: boolean;
}

const { post, allPosts, headings = [], draft = false } = Astro.props;
const d = post.data;
const url = postUrl(post);
const { previous, next } = getPrevNext(post, allPosts);
const tagCounts = collectTagCounts(allPosts);
const description = d.subtitle || undefined;
const catalogItems = d.catalog
    ? headings.map(h => ({
        depth: h.depth,
        slug: h.slug,
        text: h.text.replace(/\s*¶+\s*$/g, "").trim() || h.slug,
    }))
    : [];
const minCatalogDepth = catalogItems.length > 0
    ? Math.min(...catalogItems.map(item => item.depth))
    : 2;
const catalogCollapsible = catalogItems.length > 10;
const pageTitle = draft ? `[Draft] ${d.title}` : d.title;
---

<BaseLayout
    title={pageTitle}
    description={description}
    subtitle={d.subtitle}
    headerImg={d.headerImg}
    pageUrl={url}
    noindex={draft}
>
    {
        draft && (
            <div class="draft-banner" role="status">
                <div class="container">
                    <strong>Draft</strong>
                    {" — "}
                    work in progress; not on home / archive / feed.
                    {" "}
                    <a href="/drafts/">All drafts</a>
                    {" · "}
                    Move to <code>src/content/posts/</code> to publish.
                </div>
            </div>
        )
    }

    <IntroHeader
        type="post"
        title={d.title}
        titleHtml={d.titleHtml}
        subtitle={d.subtitle}
        author={d.author}
        publishedDate={d.publishedDate}
        headerImg={d.headerImg}
        headerMask={d.headerMask}
        headerStyle={d.headerStyle}
        tags={d.tags}
        image={d.image}
        postId={post.id}
        pageUrl={url}
    />

    <article>
        <div class="container">
            <div class="row">
                <PostContainer
                    post={post}
                    previous={previous}
                    next={next}
                >
                    <slot />
                </PostContainer>
                {
                    d.catalog && catalogItems.length > 0 && (
                        <aside class="col-lg-2 col-lg-offset-0 visible-lg-block sidebar-container catalog-container" aria-label="文章目录">
                            <div class:list={["side-catalog", catalogCollapsible && "is-collapsible"]}>
                                <div class="catalog-header">
                                    <button type="button" class="catalog-toggle" aria-expanded="true">
                                        <span class="catalog-title">文章目录</span>
                                        <span class="catalog-progress" aria-hidden="true">0%</span>
                                    </button>
                                </div>
                                <div class="catalog-track-wrap">
                                    <svg class="catalog-svg" aria-hidden="true"></svg>
                                    <ul class="catalog-body">
                                        {
                                            catalogItems.map(item => {
                                                const level = Math.min(Math.max(item.depth - minCatalogDepth, 0), 3);
                                                return (
                                                    <li
                                                        class={`h${item.depth}_nav catalog-item level-${level}`}
                                                        data-level={level}
                                                        data-slug={item.slug}
                                                    >
                                                        <a href={`#${item.slug}`} title={item.text}>
                                                            {item.text}
                                                        </a>
                                                    </li>
                                                );
                                            })
                                        }
                                    </ul>
                                </div>
                            </div>
                        </aside>
                    )
                }
                <Sidebar enable={false} tagCounts={tagCounts} postTotal={allPosts.length} />
            </div>
        </div>
    </article>

    {site.katex && d.math === true && <Katex />}
</BaseLayout>
