---
import { site } from "../data/site";
import Meta from "./Meta.astro";
import GoogleAnalytics from "./GoogleAnalytics.astro";

interface Props {
    title?: string;
    description?: string;
    subtitle?: string;
    headerImg?: string;
    feature?: boolean;
    pageUrl?: string;
    noindex?: boolean;
}

const props = Astro.props;
const pageTitle = props.title
    ? `${props.title.replace(/<[^>]+>/g, "")} - ${site.seoTitle}`
    : site.seoTitle;

const pageDescription = (
    props.description ??
    props.subtitle ??
    site.description
).replace(/<[^>]+>/g, "").trim();

const canonicalPath = props.pageUrl ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, site.url).href.replace(/\/index\.html$/, "/");
---

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <title>{pageTitle}</title>
    <GoogleAnalytics />
    <!-- Main CSS injected by BaseLayout via Vite (tc-blog.scss) -->
    <link
        rel="preload"
        href={`${site.baseurl}/fonts/woff2/iosevka-light.woff2`}
        as="font"
        type="font/woff2"
        crossorigin
    />
    <link
        rel="preload"
        href={`${site.baseurl}/fonts/woff2/iosevka-regular.woff2`}
        as="font"
        type="font/woff2"
        crossorigin
    />
    <link
        rel="preload"
        href={`${site.baseurl}/fonts/woff2/iosevka-bold.woff2`}
        as="font"
        type="font/woff2"
        crossorigin
    />
    <link rel="stylesheet" href={`${site.baseurl}/css/iosevka.css`} />
    <link rel="stylesheet" href={`${site.baseurl}/css/fonts.css`} />

    {
        site.googleSiteVerification && (
            <meta name="google-site-verification" content={site.googleSiteVerification} />
        )
    }
    <meta name="description" content={pageDescription} />
    <meta name="baseurl" content={site.baseurl} />
    <meta name="theme-color" content="#000000" />
    {props.noindex && <meta name="robots" content="noindex, nofollow" />}
    <Meta {...props} pageUrl={canonicalPath} />
    <link rel="icon" href={`${site.baseurl}/img/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate icon" href={`${site.baseurl}/img/favicon.ico`} type="image/x-icon" />
    <link rel="shortcut icon" href={`${site.baseurl}/img/favicon.ico`} type="image/x-icon" />
    {!props.noindex && <link rel="canonical" href={canonical} />}
</head>
