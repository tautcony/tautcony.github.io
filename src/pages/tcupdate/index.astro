---
/**
 * Tools downloads page integrated into BaseLayout + IntroHeader so users can
 * switch seamlessly via the primary navbar.
 * Canonical URL: /tcupdate/  → dist/tcupdate/index.html
 * Alias: /tcupdate.html via astro.config redirects (meta refresh for static host).
 */
import "../../styles/tcupdate.scss";
import BaseLayout from "../../layouts/BaseLayout.astro";
import IntroHeader from "../../components/IntroHeader.astro";
import ToolDownload from "../../components/ToolDownload.astro";
import ReleaseHistory from "../../components/ReleaseHistory.astro";
import { pageMeta } from "../../data/pages";

const meta = pageMeta.tcupdate;
---

<BaseLayout
    title={meta.title}
    description={meta.description}
    headerImg={meta.headerImg}
    pageUrl={meta.path}
>
    <IntroHeader
        type="page"
        title={meta.title}
        description={meta.description}
        headerImg={meta.headerImg}
        short={meta.shortHeader}
    />

    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
                <section id="tool-downloads" class="general">
                    <p id="release-status" role="status" aria-live="polite">
                        Refreshing GitHub releases...
                    </p>
                    <div id="downlinks">
                        <ToolDownload width="wide" owner="tautcony" repo="ChapterTool" />
                        <ToolDownload width="wide" owner="vcb-s" repo="Auto-Torrent-Inspection" />
                        <ToolDownload width="middle" owner="vcb-s" repo="RP-Checker" />
                        <ToolDownload width="middle" owner="tautcony" repo="ISTA-Patcher" />
                    </div>

                    <p id="ChapterTool">
                        <a href="https://github.com/tautcony/ChapterTool" target="_blank" rel="noopener">ChapterTool</a>{" "}
                        is designed for extracting chapters from various types of files. The core part of
                        ChapterTool has been separated as an independent library{" "}
                        <a href="https://www.nuget.org/packages/ChapterTool.Core" target="_blank" rel="noopener">ChapterTool.Core</a>.
                        So you can write your own frontend for any reason(
                    </p>
                    <div class="tool-note">
                        PS₁: The MKV file support is powered by MKVToolNix, you can get the program from{" "}
                        <a
                            href="https://mkvtoolnix.download/downloads.html#windows"
                            target="_blank"
                            rel="noopener"
                        ><b>HERE</b></a>.
                    </div>

                    <p id="ATI">
                        <a
                            href="https://github.com/vcb-s/auto-torrent-inspection"
                            target="_blank"
                            rel="noopener"
                        >AutoTorrentInspection</a>{" "}
                        is made for checking issues in such as file naming, text file encoding.
                    </p>

                    <p id="RPChecker">
                        <a href="https://github.com/vcb-s/rp-checker" target="_blank" rel="noopener">RPChecker</a>{" "}
                        is designed to compare the difference between two video clips by calculating the{" "}
                        <a
                            href="https://en.wikipedia.org/wiki/Peak_signal-to-noise_ratio"
                            target="_blank"
                            rel="noopener"
                        >PSNR</a>{" "}
                        /{" "}
                        <a
                            href="https://en.wikipedia.org/wiki/Structural_similarity"
                            target="_blank"
                            rel="noopener"
                        >SSIM</a>{" "}
                        value.
                    </p>
                    <div class="tool-note">
                        PS₀: For ffmpeg implementation, you can get the program from{" "}
                        <a
                            href="https://ffmpeg.org/download.html#build-windows"
                            target="_blank"
                            rel="noopener"
                        ><b>HERE</b></a>.
                        <br />
                        PS₁: For VapourSynth implementation, you need to make sure that{" "}
                        <a href="https://www.python.org/downloads/" target="_blank" rel="noopener"><b>Python</b></a>,{" "}
                        <a
                            href="https://github.com/vapoursynth/vapoursynth/releases"
                            target="_blank"
                            rel="noopener"
                        ><b>VapourSynth</b></a>,{" "}
                        <a
                            href="https://github.com/AkarinVS/L-SMASH-Works"
                            target="_blank"
                            rel="noopener"
                        ><b>L-SMASH-Works</b></a>,{" "}
                        <a
                            href="https://github.com/AmusementClub/vs-ComparePlane"
                            target="_blank"
                            rel="noopener"
                        ><b>vs-ComparePlane</b></a>
                        {" "}are properly installed before using the RPChecker.
                    </div>

                    <p id="ISTA-Patcher">
                        <a href="https://github.com/tautcony/ISTA-Patcher" target="_blank" rel="noopener">ISTA-Patcher</a>{" "}
                        is an IL patcher for ISTA-P, to skip the activation process.
                    </p>

                    <div class="tool-history-grid">
                        <div class="tool-history-block">
                            <h3>ChapterTool History Releases</h3>
                            <div class="all-releases-w">
                                <ReleaseHistory owner="tautcony" repo="ChapterTool" />
                            </div>
                        </div>
                        <div class="tool-history-block">
                            <h3>AutoTorrentInspection History Releases</h3>
                            <div class="all-releases-w">
                                <ReleaseHistory owner="vcb-s" repo="auto-torrent-inspection" />
                            </div>
                        </div>
                        <div class="tool-history-block">
                            <h3>RPChecker History Releases</h3>
                            <div class="all-releases-w">
                                <ReleaseHistory owner="vcb-s" repo="rp-checker" />
                            </div>
                        </div>
                        <div class="tool-history-block">
                            <h3>ISTA-Patcher History Releases</h3>
                            <div class="all-releases-w">
                                <ReleaseHistory owner="tautcony" repo="ISTA-Patcher" />
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    import "../../client/entries/tcupdate.ts";
</script>
